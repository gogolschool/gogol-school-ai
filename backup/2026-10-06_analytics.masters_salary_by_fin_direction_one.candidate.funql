{
    $year int @{ caption = 'Год' },
    $month int @{ caption = 'Месяц' },
    $fin_direction string @{ caption = 'Фин. направление' }
}:
    WITH all_data AS (
        -- Основные занятия
        SELECT
            visits_for_lessons.contact AS master_id,
            COALESCE(
                products.fin_segment=>name,
                ct.segment=>name,
                CASE
                    WHEN ct.name IN ('HEAD', 'ОУ HEAD') THEN 'B2C TOP'
                    WHEN ct.name IN ('Абонемент', 'МК по абонементу', 'Лаборатория', 'Интенсив', 'Интенсив YNG', 'YEAR', 'Открытый урок', 'Открытый урок YNG', 'Интенсив СПБ', 'МК СПБ') THEN 'B2C'
                    ELSE 'Неизвестно'
                END
            ) AS fin_direction,
            calc_visit_payout(visits_for_lessons.id) AS summ
        FROM crm.visits_for_lessons
            LEFT JOIN base.people
                ON visits_for_lessons.contact = people.id
            LEFT JOIN crm.actions AS lessons ON visits_for_lessons.action = lessons.id
            LEFT JOIN crm.actions AS products ON products.id = lessons.parent_action
            LEFT JOIN crm.class_type AS ct ON ct.id = products.class_type
        WHERE people.is_employee
          AND visits_for_lessons."datetime" IS NOT NULL
          AND (($month = 0 AND $year = 0) OR
               (date_part('month', visits_for_lessons."datetime") = $month
                AND date_part('year', visits_for_lessons."datetime") = $year))

        UNION ALL

        -- Дополнительные занятия с заполненным направлением
        SELECT
            mal.master AS master_id,
            mal.fin_segment=>name AS fin_direction,
            COALESCE(mal.price, 0) AS summ
        FROM staffs.masters_additional_lessons AS mal
        WHERE mal.fin_segment IS NOT NULL
          AND (($month = 0 AND $year = 0) OR
               (date_part('month', mal."date") = $month
                AND date_part('year', mal."date") = $year))
    ),
    grouped AS (
        SELECT
            fin_direction,
            master_id,
            SUM(summ) AS summ
        FROM all_data
        WHERE fin_direction = $fin_direction
        GROUP BY fin_direction, master_id
    )
    SELECT
        @type = 'table',
        @title = 'ЗП ' || $fin_direction,
        @export_to_csv = true,
        p.main_name @{
            caption = 'Сотрудник',
            column_width = 220
        },
        $month @{ column_width = 55, text_align = 'center' },
        $year @{ column_width = 55, text_align = 'center' },
        summ @{
            caption = 'Сумма ЗП',
            number_format = 'ru',
            column_width = 120
        }
    FROM grouped
        LEFT JOIN base.people AS p ON p.id = grouped.master_id
    WHERE grouped.summ <> 0
    ORDER BY p.main_name